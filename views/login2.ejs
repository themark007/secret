<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rooted Connections - Love & Self Discovery</title>
    <style>
        :root {
            --earth-green: #6c8672;
            --sage: #a4b8a5;
            --muted-teal: #8aa39b;
            --deep-root: #3a4e48;
        }

        body {
            margin: 0;
            height: 100vh;
            background: linear-gradient(45deg, #e6e2d3 0%, #c8d5b9 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: 'Helvetica', sans-serif;
        }

        .forest-container {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .tree {
            position: absolute;
            bottom: -50px;
            animation: sway 8s ease-in-out infinite;
        }

        .tree::before {
            content: '';
            position: absolute;
            width: 20px;
            height: 100px;
            background: #5a4d41;
            border-radius: 8px;
        }

        .tree::after {
            content: '';
            position: absolute;
            bottom: 80px;
            left: -30px;
            width: 80px;
            height: 120px;
            background: var(--earth-green);
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
            opacity: 0.8;
        }

        @keyframes sway {
            0%, 100% { transform: translateX(0) rotate(0deg); }
            25% { transform: translateX(-5px) rotate(-1deg); }
            75% { transform: translateX(5px) rotate(1deg); }
        }

        .container {
            background: rgba(255, 255, 255, 0.9);
            padding: 2.5rem;
            border-radius: 25px;
            box-shadow: 0 10px 40px rgba(90, 77, 65, 0.2);
            position: relative;
            animation: gentleAppear 1.5s ease-out;
            max-width: 400px;
            backdrop-filter: blur(5px);
        }

        @keyframes gentleAppear {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        h1 {
            color: var(--deep-root);
            text-align: center;
            margin-bottom: 2rem;
            font-weight: 300;
            position: relative;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: var(--muted-teal);
            animation: lineGrow 1s ease-out;
        }

        @keyframes lineGrow {
            from { width: 0; }
            to { width: 60px; }
        }

        .form-group {
            margin-bottom: 1.8rem;
            position: relative;
        }

        input {
            width: 100%;
            padding: 1rem;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.9);
        }

        input:focus {
            outline: none;
            border-color: var(--muted-teal);
            box-shadow: 0 0 15px rgba(138, 163, 155, 0.2);
        }

        button {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(45deg, var(--deep-root), var(--earth-green));
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(90, 77, 65, 0.3);
        }

        .leaf {
            position: absolute;
            animation: floatDown 15s linear infinite;
            opacity: 0.7;
            font-size: 24px;
        }

        @keyframes floatDown {
            0% { transform: translateY(-100vh) rotate(0deg); }
            100% { transform: translateY(100vh) rotate(360deg); }
        }

        .path {
            position: absolute;
            width: 100%;
            height: 100%;
            stroke-dasharray: 1000;
            stroke-dashoffset: 1000;
            animation: draw 20s linear infinite;
            opacity: 0.1;
        }

        @keyframes draw {
            to { stroke-dashoffset: 0; }
        }

        .glow-particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: rgba(255, 215, 150, 0.8);
            border-radius: 50%;
            animation: twinkle 2s infinite;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.2; }
            50% { opacity: 1; transform: scale(1.5); }
        }
    </style>
</head>
<body>
    <div class="forest-container">
        <svg class="path" viewBox="0 0 100 100">
            <path d="M10 50 Q 25 30 40 50 Q 55 70 70 50 Q 85 30 90 50" 
                  fill="none" 
                  stroke="#5a4d41" 
                  stroke-width="0.5"/>
        </svg>
    </div>
    
    <div class="container">
        <h1>Login</h1>
        <form id="loginForm" action="/login" method="POST">
            <div class="form-group">
                <input type="text" name="username" placeholder="username" id="username" required>
            </div>
            <div class="form-group">
                <input type="password" name="password" placeholder="password" id="password" required>
            </div>
            <button type="submit">Begin Journey</button>
        </form>
    </div>

    <script>
        function createNatureElements() {
            const container = document.querySelector('.forest-container');
            
            // Create trees
            for(let i = 0; i < 5; i++) {
                const tree = document.createElement('div');
                tree.className = 'tree';
                tree.style.left = `${Math.random() * 100}%`;
                tree.style.animationDelay = `${Math.random() * 2}s`;
                container.appendChild(tree);
            }

            // Create falling leaves
            const leaves = ['🍃', '🍂', '🌿', '🍁'];
            setInterval(() => {
                const leaf = document.createElement('div');
                leaf.className = 'leaf';
                leaf.textContent = leaves[Math.floor(Math.random() * leaves.length)];
                leaf.style.left = `${Math.random() * 100}%`;
                leaf.style.animationDuration = `${5 + Math.random() * 10}s`;
                leaf.style.color = `hsl(${Math.random() * 360}, 50%, 50%)`;
                container.appendChild(leaf);
                
                setTimeout(() => leaf.remove(), 15000);
            }, 500);

            // Create glow particles
            for(let i = 0; i < 30; i++) {
                const particle = document.createElement('div');
                particle.className = 'glow-particle';
                particle.style.left = `${Math.random() * 100}%`;
                particle.style.top = `${Math.random() * 100}%`;
                particle.style.animationDelay = `${Math.random() * 2}s`;
                container.appendChild(particle);
            }
        }

        document.getElementById('loginForm').addEventListener('submit', function(e) {
            const inputs = document.querySelectorAll('input');
            let isValid = true;

            inputs.forEach(input => {
                if (!input.value) {
                    isValid = false;
                    input.style.borderColor = '#ff6b6b';
                    setTimeout(() => {
                        input.style.borderColor = '#ddd';
                    }, 2000);
                }
            });

            if (!isValid) e.preventDefault();
        });

        createNatureElements();
    </script>
</body>
</html>